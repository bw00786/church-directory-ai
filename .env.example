# ATEM Configuration
ATEM_IP=192.168.30.20
ATEM_BRIDGE_HOST=127.0.0.1
ATEM_BRIDGE_PORT=8090
ATEM_POLL_SECONDS=1.0                     # bridge status poll; PROGRAM_CHANGED / PREVIEW_CHANGED latency
# The ATEM takes a new DHCP address when power-cycled. The resolver discovers it
# by MAC (Blackmagic OUI) on these subnets so you don't have to edit ATEM_IP each week.
ATEM_RESOLVE_ENABLED=true
ATEM_RESOLVE_SUBNETS=192.168.4
# ATEM_RESOLVE_OUI=7c:2e:0d
# ATEM_RESOLVE_MAC=7c:2e:0d:xx:xx:xx   # pin an exact switcher if several are present

# FastAPI. Loopback by default (operator UI on the same PC). To serve the LAN set
# API_HOST=0.0.0.0 -- the auth gate then refuses to serve until API keys are set.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# Control-plane authentication (app/security/auth.py). Every non-public route and
# WebSocket needs a key: X-API-Key / Authorization: Bearer / WebSocket ?token=.
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# `scripts/setup-windows.ps1` fills these in for you on a fresh install.
API_AUTH_ENABLED=true
API_KEY=                                  # operator role: run the service, approve AI suggestions
API_ADMIN_KEY=                            # admin role: also change the AI Director mode
API_ALLOW_UNAUTHENTICATED_READS=false     # true lets wall displays read status without a key
# Refuse to start with placeholder secrets / missing keys unless every hardware
# integration is mocked (a developer laptop). Leave true on a church PC.
SECURITY_STRICT_STARTUP=true

# React Frontend (build-time). Leave VITE_API_BASE_URL empty for same-origin when the
# SPA is served by the backend; `npm run dev` falls back to http://localhost:8000.
VITE_API_BASE_URL=
# VITE_API_KEY=                           # optional baked-in key; otherwise the UI prompts and stores it

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=church_production
POSTGRES_USER=church
POSTGRES_PASSWORD=                        # set a real password (the setup script generates one)
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Ollama inference (Qwen) on the EasyWorship PC, called over Ollama's REST API.
# Leave OLLAMA_BASE_URL empty on a DHCP network: the backend finds Ollama itself
# (EASYWORSHIP_REMOTE_HOST / agent host, the EasyWorship PC found by the remote
# driver or mDNS, localhost, then a port-11434 sweep of the local /24), re-checks
# every OLLAMA_DISCOVERY_INTERVAL_SECONDS and after a failed call. Setting a URL
# turns discovery off. On the EW PC set the Windows env var
# OLLAMA_HOST=0.0.0.0:11434 and allow TCP 11434 inbound from the local subnet only.
OLLAMA_BASE_URL=
OLLAMA_DISCOVERY_ENABLED=true
OLLAMA_DISCOVERY_SCAN=true               # sweep the /24 when the EasyWorship PC isn't found
OLLAMA_DISCOVERY_SUBNETS=                # e.g. 192.168.4,192.168.1; empty => this machine's /24
OLLAMA_DISCOVERY_INTERVAL_SECONDS=60
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=1.5
# Exact installed tag on the EW PC (`ollama list`), NOT qwen3:8b.
OLLAMA_MODEL=qwen3.8:latest
OLLAMA_FAST_MODEL=qwen3.8:latest
OLLAMA_VISION_MODEL=qwen3.8:latest
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REASONING=false
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

# Voyage AI embeddings are independent of Ollama and are not migrated.
# Used for production-memory retrieval
# (search_past_services, AI Director's retrieval-augmented context). Leave
# blank to use a local fallback embedding instead (lower retrieval quality,
# no external calls/cost).
# Create a key at https://dash.voyageai.com/ and keep it out of source control
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large

# Embedding provider tier: "auto" (default) = Voyage if VOYAGE_API_KEY is set,
# else local nomic-embed-text-v1.5 (free, no API key), else hashed bag-of-words.
# Force one explicitly with "voyage" | "nomic" | "hashed".
EMBEDDING_PROVIDER=auto
# Run backend/scripts/migrate_memory_vectors.py before indexed RAG use.
# Select a stable provider before --backfill; queries isolate actual model spaces.
NOMIC_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# NOMIC_MODEL_REVISION=  # pin a commit hash in production (trust_remote_code=True)

# Production Policy
# Camera switching: true = AI can autonomously switch, false = AI recommends only
AUTONOMOUS_CAMERA_SWITCHING=true

# Transitions: true = AI can perform CUT/AUTO, false = preview only
AUTONOMOUS_TRANSITIONS=true

# Streaming: true = AI can start/stop stream (NOT RECOMMENDED)
AUTONOMOUS_STREAM_START=false
AUTONOMOUS_STREAM_STOP=false

# Recording: true = AI can start/stop recording (NOT RECOMMENDED)
AUTONOMOUS_RECORDING=false

# AI Behavior Tuning
MIN_CAMERA_HOLD_SECONDS=8
MIN_AI_ACTION_CONFIDENCE=0.85
MAX_CONSECUTIVE_SWITCHES=3
CAMERA_SWITCH_COOLDOWN_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=                               # random string; the setup script generates one
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features
ENABLE_MOCK_ATEM=true
# When true (default), the app probes the real ATEM bridge on connect and uses it
# automatically when reachable, falling back to the mock bridge otherwise.
# Set to false to force the ENABLE_MOCK_ATEM value above with no probing.
ATEM_AUTO_DETECT=true
ATEM_PROBE_TIMEOUT_SECONDS=1.5
ENABLE_AI_DIRECTOR=true
ENABLE_VISION_DETECTION=false

# Identity recognition & persistent roster memory
# Face matching uses OpenCV's YuNet (deep-learning face detector) + SFace
# (trained face-recognition embedding network) whenever their ONNX weights
# are present under backend/app/identity/models_data/ (bundled by default in
# this repo) -- both are real pretrained models from the official OpenCV
# Zoo, not a placeholder. If those weight files are ever removed/unavailable,
# face recognition automatically falls back to a classical Haar-cascade +
# LBP-histogram method (lower accuracy, but never a hard failure). Voice
# matching uses framed FFT spectral features + pitch statistics. Both are
# matched against people enrolled via POST /api/identity/roster and stored
# in Postgres (identity_* tables).
FACE_RECOGNITION_ENABLED=true
VOICE_DIARIZATION_ENABLED=true
# 0.363 is OpenCV's published operating point for the SFace model above; if
# running in classical Haar+LBP fallback mode, raise this to ~0.6-0.75.
FACE_MATCH_THRESHOLD=0.363
VOICE_MATCH_THRESHOLD=0.70
UNKNOWN_SPEAKER_TTL_SECONDS=300.0
VOICE_SILENCE_RMS=0.02

# Liveness / anti-spoofing gate on live-feed face recognition (texture +
# temporal micro-motion heuristics). Raises the bar against a printed photo
# held up to the camera; does not detect a video replay. Failed checks are
# still logged for audit but don't count as a "sighting" or feed the
# role->preset learning below.
LIVENESS_CHECK_ENABLED=true
LIVENESS_SCORE_THRESHOLD=0.35

# Role -> preset learning confidence floor (see app.director.engine): a
# learned preset is only trusted once it has at least this many
# co-occurrence observations AND leads the runner-up preset by this many,
# otherwise the cue sheet's configured fallback preset is used.
MIN_ROLE_PRESET_SAMPLES=8
MIN_ROLE_PRESET_MARGIN=3

# Local audio capture: the MGX16 has no raw-audio remote protocol, so genuine
# voice diarization needs a physical audio input on this machine (e.g. the
# mixer's monitor/aux out, or a room mic) wired into a line-in/USB interface.
# Requires the `sounddevice` package (PortAudio) and an actual input device.
ENABLE_AUDIO_CAPTURE=false
AUDIO_CAPTURE_DEVICE=
AUDIO_CAPTURE_SAMPLE_RATE=16000
AUDIO_CAPTURE_WINDOW_SECONDS=2.0
AUDIO_CAPTURE_CHANNEL_NAME=room_mic

# PTZ Camera (optional)
# Configure a single PTZOptics camera for automatic registration on startup.
# Example: CAMERA_1_HOST=192.168.1.201
CAMERA_1_NAME=PTZOptics Camera 1
CAMERA_1_HOST=
# HTTP-CGI port (PTZOptics web UI / ptzctrl.cgi)
CAMERA_1_PORT=80
CAMERA_1_USERNAME=admin
# Change the camera's factory password in its web UI first, then put it here.
# The backend refuses non-mock startup while this is a known factory default.
CAMERA_1_PASSWORD=
# VISCA-over-IP UDP port (primary control path)
CAMERA_1_VISCA_PORT=1259
# Use UDP (Sony-header) VISCA instead of TCP
CAMERA_1_VISCA_UDP=true
# VISCA link health: two ACK timeouts mark the link dead (CGI fallback + backoff
# reconnect); preset/absolute moves wait up to the completion timeout for end of motion.
VISCA_ACK_TIMEOUT_SECONDS=0.5
VISCA_COMPLETION_TIMEOUT_SECONDS=8.0
VISCA_PRESET_RECALL_SPEED=0              # 0 = camera default; 1..24 PTZOptics recall speed

# Service Director (scripted Sunday service)
# ATEM program input mapping: camera 1 = PTZOptics, camera 2 = EasyWorship laptop
ATEM_CAMERA1_INPUT=1
ATEM_CAMERA2_INPUT=2
PTZ_CAMERA_ID=1
SERVICE_COUNTDOWN_SECONDS=300
SERVICE_AUTONOMOUS=true
# Scheduled auto-start (wall clock, local time); days are comma-separated mon..sun
SERVICE_AUTO_START_ENABLED=false
SERVICE_START_TIME=10:00
SERVICE_START_DAYS=sun

# AI Service Director (reasoning layer above the cue engine; docs/ai-director.md)
# manual      = observe/log only
# assisted    = propose actions, operator approves each one (default)
# ai_directed = execute automatically (still gated by the policy flags above)
# Fully autonomous operation = AI_DIRECTOR_MODE=ai_directed + SERVICE_AUTONOMOUS=true
# + SERVICE_AUTO_START_ENABLED=true + AUTONOMOUS_CAMERA_SWITCHING/TRANSITIONS=true
# + real (non-mock) ATEM, mixer, and EasyWorship connections.
AI_DIRECTOR_MODE=assisted
# Voice playback stays disabled until dedicated-headset isolation is tested onsite.
VOICE_ENABLED=false
VOICE_MODE=attention_only
VOICE_OPERATOR_NAME=Bruce
# Exact backend device/host API names required; no system-default fallback.
# Locally detected: LEVN LE-HS016 Superior / Core Audio. Isolation NOT verified.
VOICE_OUTPUT_DEVICE=
VOICE_OUTPUT_HOST_API=
VOICE_ROUTING_VERIFIED=false
VOICE_HEADSET_ONLY=true
VOICE_CHURCH_PA=false
VOICE_LIVESTREAM=false
VOICE_RECORDING=false
VOICE_COOLDOWN_SECONDS=10
VOICE_REPEAT_INTERVAL_SECONDS=120
VOICE_AGGREGATION_WINDOW_SECONDS=5
VOICE_MAX_EVENT_AGE_SECONDS=60
VOICE_QUEUE_LIMIT=100
VOICE_AUDIT_SPOOL_DIR=data/voice-outbox
# Empty uses TTS_PIPER_VOICE; otherwise an installed model filename stem only.
# The matching .onnx and .onnx.json must exist; paths and URLs are rejected.
VOICE_PERSONA__VOICE_ID=
VOICE_PERSONA__SPEAKING_RATE=0.94
# Expressiveness/breathiness are metadata, not controllable Piper guarantees.
VOICE_PERSONA__EXPRESSIVENESS=0.70
# Local open-source speech, independent of Qwen/Ollama text generation.
# piper (default) | disabled. No cloud TTS credentials or runtime downloads.
TTS_PROVIDER=piper
# Install voice assets explicitly before testing. Relative to backend process cwd;
# use one absolute directory when launching from either the repo root or backend.
TTS_PIPER_MODEL_DIR=data/piper-voices
TTS_PIPER_VOICE=en_US-ljspeech-high
TTS_TIMEOUT_SECONDS=30

AI_DIRECTOR_POLL_SECONDS=4.0
# Director inference: fast model + Ollama structured output + hard deadline per cycle.
AI_DIRECTOR_MODEL=                        # empty => OLLAMA_FAST_MODEL
AI_DIRECTOR_DEADLINE_SECONDS=3.0          # a slow answer becomes "continue", never a late cut
AI_DIRECTOR_MAX_TOKENS=320
AI_DIRECTOR_HOUSE_RULES_FILE=data/house-rules.md   # edit to teach the director your house style
AI_DIRECTOR_TRANSCRIPT_MIN_CONFIDENCE=0.3 # hide low-confidence ASR lines from the prompt
PHASE_LLM_REQUIRES_HARD_SIGNAL=true       # LLM phase proposals need an agreeing hard signal
PHASE_SINGING_SECONDS=8.0
# Proposal queue + pacing on the AI path (see docs/ai-director.md "Pacing rules").
AI_DIRECTOR_PENDING_TTL_SECONDS=90        # unapproved proposals expire
AI_DIRECTOR_DEDUPE_SECONDS=5.0            # same effect twice within this is dropped (incl. cue-engine cuts)
AI_CUT_SPEECH_BOUNDARY_SECONDS=0.8        # hold cuts mid-sentence; 0 disables
AI_DIRECTOR_MAX_CONTEXT_DRIFT=3           # discard decisions computed on a context that moved on
AI_DIRECTOR_ADAPTIVE_FILE=data/adaptive-confidence.json
AI_DIRECTOR_EVIDENCE_MAX_AGE_SECONDS=3.0
AI_DIRECTOR_MIN_CONFIDENCE=0.80
CONFIDENCE_CAMERA_CHANGE=0.85
CONFIDENCE_SLIDE_CHANGE=0.85
CONFIDENCE_ATEM_TRANSITION=0.90

# --- Autonomy roadmap (docs/ai-director.md). Flags below default OFF except
# the song follower. Proposals from these components honor AI_DIRECTOR_MODE
# (assisted => queued for operator approval).

# Phase 1: song/reading text-follow slide advance. Aligns the live ASR transcript
# (liturgist ch 2, vocalist, congregation ch 8) to the live slide's text and
# proposes EASYWORSHIP_NEXT_SLIDE when the reader reaches the end of the slide.
# Slide text: per-item texts via PUT /api/director/slide-texts (blank line between
# slides), else OCR of the camera-2 (EasyWorship PC) feed on SLIDE_VERIFY_DEVICE.
# Needs per-channel ASR: MGX_USB_ENABLED=true + ENABLE_WHISPER=true.
SONG_FOLLOWER_ENABLED=true
SONG_FOLLOWER_MIN_CONFIDENCE=0.72        # matched fraction of the slide's closing words
SONG_FOLLOWER_MIN_ANCHOR_WORDS=3         # next-slide opening words that must match (catch-up)
SONG_FOLLOWER_TAIL_WORDS=8               # closing words used to detect "slide finished"
SONG_FOLLOWER_ROLES=liturgist,congregation,vocalist  # also added to WHISPER_ROLES
SONG_FOLLOWER_COOLDOWN_SECONDS=2.5       # min gap between proposed advances
SONG_FOLLOWER_CUES=first_song,call_to_worship_slides,hymn_of_praise,scripture_reading,lords_prayer,doxology,closing_praise
SONG_FOLLOWER_TEXTS_FILE=data/slide-texts.json
SONG_FOLLOWER_OCR_ENABLED=true           # fall back to OCR of the camera-2 slides feed
SONG_FOLLOWER_OCR_WAIT_SECONDS=3.0       # max wait for the new slide after an advance
SONG_FOLLOWER_SCOPE=texts                # cues | texts (cues + items with supplied texts) | always
SONG_FOLLOWER_WATCH_SECONDS=1.0          # resync on manual slide changes (EasyWorship + OCR); 0 = off
SONG_FOLLOWER_OCR_LEARN=true             # remember OCR'd slides per item for next-slide look-ahead
SONG_FOLLOWER_OCR_LEARN_FILE=data/slide-texts-learned.json
SONG_FOLLOWER_SCREEN_WEIGHT=0.3          # camera-2 screen agreement share of proposal confidence
SONG_FOLLOWER_ROLE_WEIGHTS=vocalist:1.0,liturgist:1.0,congregation:0.85  # room mic ASR is noisier

# Learn from the operator's own slide advances (any mode, incl. manual): slide
# changes the app didn't command are recorded with the camera-2 slide text, the
# words heard before the click and timing; the follower reuses them as advance
# cues + timing guards, and they go to production memory for the AI director.
OPERATOR_LEARNING_ENABLED=true
OPERATOR_LEARNING_POLL_SECONDS=1.0
OPERATOR_LEARNING_COMMAND_WINDOW_SECONDS=3.0  # app-sent commands within this aren't the operator's
OPERATOR_LEARNING_CONTEXT_SECONDS=20.0       # transcript window before a click
OPERATOR_LEARNING_TAIL_WORDS=12
OPERATOR_LEARNING_FILE=data/operator-slide-advances.json
OPERATOR_LEARNING_MAX_SAMPLES=8              # newest samples kept per slide
OPERATOR_LEARNING_MIN_SAMPLES=2              # before the follower uses a slide's history
OPERATOR_LEARNING_MIN_DWELL_FRACTION=0.35    # no advance before this share of the usual slide time (0 = off)
OPERATOR_LEARNING_MEMORY=true                # also write advances to production memory
#
# Church PC checklist for audio + camera-2 slide following:
#   MGX_USB_ENABLED=true, ENABLE_WHISPER=true (below), and SLIDE_VERIFY_DEVICE set to
#   the camera-2 (EasyWorship PC) capture device. Then SLIDE_VERIFY_ENABLED=true to
#   confirm every advance (startup fails if the device can't be opened).

# Phase 2: event-driven decision ticks + predictive PTZ preview staging.
AI_DIRECTOR_EVENT_DRIVEN=true            # wake the decision loop on key events (speaker change, cue, slide)
AI_DIRECTOR_EVENT_MIN_INTERVAL_SECONDS=1.0
PTZ_PREDICTIVE_PREVIEW=false             # pre-stage PTZ + ATEM preview, never cuts

# Phase 3: service-end recognition + shutdown bundle.
SERVICE_END_ENABLED=false
SERVICE_END_KEYWORDS=benediction,go in peace,amen and amen,depart in peace,you are dismissed
SERVICE_END_SILENCE_SECONDS=45.0         # sustained quiet after arming => ended
SERVICE_END_AUTO_SHUTDOWN=false          # ai_directed may run the stop bundle

# Phase 4: learning loop, adaptive confidence, evidence fusion.
AI_DIRECTOR_LEARNING_ENABLED=false       # record operator approvals/rejections to memory
AI_DIRECTOR_ADAPTIVE_CONFIDENCE=false
AI_DIRECTOR_ADAPTIVE_STEP=0.02           # per-outcome threshold nudge
AI_DIRECTOR_ADAPTIVE_MIN=0.60
AI_DIRECTOR_ADAPTIVE_MAX=0.98
AI_DIRECTOR_EVIDENCE_FUSION=false        # require vision to corroborate camera cuts

# Yamaha MGX16 mixer (listen-only, via the mgx-ai-mixer meter WebSocket)
# App: https://github.com/bw00786/ai-yamaha-mixer-control (mgx-ai-mixer),
# runs on the SAME machine as this backend (USB-C MAIN into that machine).
# Its own default is --port 8000, which collides with API_PORT above, so
# start it with: uvicorn app.main:app --port 9000
ENABLE_MOCK_MIXER=true
MIXER_WS_URL=ws://127.0.0.1:9000/ws
# REST base of mgx-ai-mixer for software-DSP control (HPF/EQ/comp/trim, feedback
# guard, mix keeper). Defaults to the http:// form of MIXER_WS_URL.
# MIXER_API_URL=http://127.0.0.1:9000
SONG_END_SILENCE_DB=-45.0
SONG_END_HOLD_SECONDS=3.0
# Yamaha role channels (1-based). The vocalist is channel 4 at this site.
MIXER_VOCALIST_CHANNEL=4
MIXER_CONGREGATION_CHANNEL=8

# MGX16 USB MAIN multichannel PCM capture (WO-MGX-USB-1).
# Real per-channel waveform from the console's USB-C MAIN port -> Silero VAD +
# per-role Whisper. The meter feed above stays as the degraded fallback.
# Requires the `sounddevice` package (PortAudio). Leave disabled to keep the
# pre-WO meter-only behavior exactly. Falls back to the meter feed if the
# device isn't found.
MGX_USB_ENABLED=true
MGX_USB_DEVICE_NAME=MGX
MGX_USB_DEVICE_INDEX=            # optional explicit PortAudio index override
MGX_USB_SAMPLE_RATE=48000       # negotiated with the driver; do not require 96k
MGX_USB_STALL_SECONDS=2.0       # no frames within this => channel degrades

# Voice-activity detection: auto = Silero when USB capture is active, energy
# otherwise. silero/energy force one. Silero falls back to energy loudly.
VAD_PROVIDER=auto               # auto | silero | energy
VAD_SILERO_THRESHOLD=0.5
VAD_SILERO_RESET_SILENCE_SECONDS=3.0   # reset Silero's state after this much silence
# The congregation mic hears the pastor through the PA: a channel this many dB
# below the loudest co-active channel is treated as silence for VAD/ASR.
AUDIO_BLEED_SUPPRESS_ENABLED=true
AUDIO_BLEED_SUPPRESS_DB=12.0

# Per-channel Whisper ASR on the USB channels (needs faster-whisper or
# openai-whisper installed; stays off without one).
ENABLE_WHISPER=true
# Which role channels get per-channel Whisper ASR (comma-separated). While the
# song follower is enabled its roles (incl. congregation) are added as well.
WHISPER_ROLES=pastor,liturgist,vocalist,congregation
WHISPER_BEAM_SIZE=1                 # 1 = fastest on CPU; 3-5 trades latency for accuracy
WHISPER_MAX_UTTERANCE_SECONDS=6.0   # flush to Whisper at least this often (was 15 s)
WHISPER_UTTERANCE_OVERLAP_SECONDS=0.5
WHISPER_MAX_CONCURRENCY=2           # simultaneous decodes across all roles
WHISPER_MIN_CONFIDENCE=0.25         # drop lines below exp(avg_logprob)*(1-no_speech_prob)
WHISPER_SKIP_SINGING_ROLES=         # e.g. pastor,liturgist; empty keeps lyrics for the song follower

# Vision observation & PTZ framing verification (WO-VISION-1).
# Gated by VISION_ENABLED; when false the system is byte-identical to pre-WO.
VISION_ENABLED=false
VISION_TEST_PATTERN=false                 # dev only: synthetic cameras for the legacy VisionManager
VISION_DETECTOR=auto                 # auto | yolo | opencv_hog
VISION_SNAPSHOT_HZ=1.0               # PTZOptics snapshot.jpg poll rate
VISION_RING_MINUTES=10               # in-memory diagnostic frame ring (not persisted)
VISION_MIN_FPS=0.2
VISION_STALL_SECONDS=3.0
VISION_PROGRAM_DEVICE=               # cv2 device index/name for ATEM program capture
VISION_FRAME_SOURCE=live             # live | dir (dir = replay from image folders)
VISION_FRAME_DIR=                    # FRAME_SOURCE=dir root (per-tag subdirs: program/, camera_1/)
# Per-role expected-subject ROI as fractional "x,y,w,h" (all in [0,1]).
VISION_ROLE_ROI_PASTOR=0.30,0.15,0.40,0.75
VISION_ROLE_ROI_LITURGIST=0.30,0.15,0.40,0.75
VISION_ROLE_ROI_VOCALIST=0.25,0.15,0.50,0.75
VISION_ROLE_ROI_CONGREGATION=0.05,0.20,0.90,0.70
# PTZ verification
PTZ_VERIFY_ACTION=enforce            # enforce | log (observation-only)
PTZ_VERIFY_DELAY_MS=1500
PTZ_OFFSET_MAX=0.25
PTZ_BLOCK_SECONDS=8.0
PTZ_UNVERIFIED_MAX=5
PTZ_SUBJECT_WAIT_SECONDS=30.0
# Ollama vision escalation (optional, off by default; out of the hot loop)
VISION_LLM_ENABLED=false
VISION_LLM_MAX_PX=1024
VISION_LLM_MAX_PER_MIN=2

# EasyWorship slide control
ENABLE_MOCK_EASYWORSHIP=true
# Driver: auto | remote | agent | keyboard | mock
#   remote   = EasyWorship 7.3+ native Remote Control TCP protocol (PREFERRED:
#              no window focus, absolute gotoSchedule/gotoSlide, live position
#              read-back used to confirm every command). Enable in EasyWorship:
#              Edit > Options > Advanced > "Enable Remote Control"; install
#              Bonjour; approve the pairing once via the Remote toolbar button.
#   agent    = HTTP keystroke agent on the EW machine (fallback)
#   keyboard = local keystroke injection (fallback; Live pane must have focus)
#   auto     = remote if EASYWORSHIP_REMOTE_HOST set, else agent if
#              EASYWORSHIP_AGENT_URL set, else remote via mDNS discovery
#              (pip install zeroconf), else keyboard on Windows
EASYWORSHIP_DRIVER=auto
# Remote protocol address. The port is announced over mDNS (_ezwremote._tcp) and
# can change; leave both blank to discover, or pin them once known.
EASYWORSHIP_REMOTE_HOST=
# EASYWORSHIP_REMOTE_PORT=
EASYWORSHIP_REMOTE_SERVER_NAME=          # only needed with several EW servers on the LAN
EASYWORSHIP_REMOTE_DEVICE_NAME=Church Production Director
EASYWORSHIP_REMOTE_UID=                  # pairing identity; auto-generated into
EASYWORSHIP_REMOTE_UID_FILE=.easyworship_remote_uid
EASYWORSHIP_REMOTE_DISCOVERY_SECONDS=5.0
# Confirm navigation against EasyWorship's reported pres_no/slide_no.
EASYWORSHIP_CONFIRM_ACTIONS=true
EASYWORSHIP_CONFIRM_TIMEOUT_SECONDS=1.5
# EW schedule items before the first service-plan item (e.g. 1 for a countdown).
EASYWORSHIP_SCHEDULE_OFFSET=0
# --- keystroke fallbacks only ---
EASYWORSHIP_WINDOW_TITLE=EasyWorship
EASYWORSHIP_SEND_MODE=foreground     # foreground | postmessage
# Remote keystroke agent (run backend/easyworship_agent/agent.py on the EW machine).
# EASYWORSHIP_AGENT_URL=http://192.168.30.40:8091
# Shared secret for that agent: the same value as EW_AGENT_TOKEN on the EasyWorship
# PC (scripts/start-easyworship-agent.ps1 prompts for it). Generated by setup-windows.ps1.
EASYWORSHIP_AGENT_TOKEN=
# Key specs per action -- EasyWorship 7.3+ defaults (Hotkeys2.ini). Comma =
# sequence: arrows only *select* a schedule item, Page Down sends it live.
EW_KEY_NEXT_SLIDE=down
EW_KEY_PREV_SLIDE=up
EW_KEY_NEXT_ITEM=right,pagedown
EW_KEY_PREV_ITEM=left,pagedown
EW_KEY_CLEAR=ctrl+c
EW_KEY_LOGO=ctrl+l
EW_KEY_BLACK=ctrl+b
EW_KEY_LIVE=pagedown

# EasyWorship slide-change verification via OCR (WO-EWVERIFY-1/-2/-3).
# Independent of VISION_ENABLED. Requires a *dedicated* camera-2/EasyWorship-
# laptop feed (e.g. an HDMI splitter + capture card on the laptop's own
# output -- NOT the switched ATEM program, which may show camera 1 instead).
# Confirms a commanded next/prev slide/item action visibly changed the
# on-screen text. Change-detection alone does NOT verify the slide is
# semantically correct for non-lyric items (sermon slides, announcements);
# lyric-aware verification is scoped separately under WO-EWVERIFY-3 below.
#
# When ENABLED, an empty DEVICE -- or a device that cannot be opened / yields
# no frames within a short startup probe -- is a hard startup failure (a
# verification feature that is "on" but never runs is a green light wired to
# nothing). On a verification failure (no visible change within the timeout,
# or a lyric mismatch) automation is halted for operator attention; the
# keystroke is never auto-retried.
SLIDE_VERIFY_ENABLED=false
SLIDE_VERIFY_DEVICE=                      # cv2 device index/name for the camera-2/slides tap
SLIDE_VERIFY_POLL_MS=400                  # stabilization poll interval (ms)
SLIDE_VERIFY_TIMEOUT_SECONDS=4.0          # give up -> alert + halt automation
SLIDE_OCR_GPU=false                       # run easyocr on CUDA (needs a GPU on the backend PC)

# Lyric-aware semantic verification (WO-EWVERIFY-3). Independent toggle on top
# of SLIDE_VERIFY_ENABLED; enabling it without change-detection is a startup
# error. Fuzzy-matches the stable post-action OCR text against the expected
# lyric text for the current song position; below the threshold -> alert + halt.
SLIDE_VERIFY_SEMANTIC_ENABLED=false
SLIDE_VERIFY_SEMANTIC_THRESHOLD=0.75     # OCR of a captured frame is noisy; tune before tightening
