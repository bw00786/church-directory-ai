# ATEM Configuration
ATEM_IP=192.168.30.20
ATEM_BRIDGE_HOST=127.0.0.1
ATEM_BRIDGE_PORT=8090

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# React Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=church_production
POSTGRES_USER=church
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Anthropic Claude
# Create a key at https://console.anthropic.com/ and keep it out of source control
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Smaller/faster model used for quick cue-advance classification
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_BASE_URL=  # optional override (e.g. a proxy/gateway)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Production Policy
# Camera switching: true = AI can autonomously switch, false = AI recommends only
AUTONOMOUS_CAMERA_SWITCHING=true

# Transitions: true = AI can perform CUT/AUTO, false = preview only
AUTONOMOUS_TRANSITIONS=true

# Streaming: true = AI can start/stop stream (NOT RECOMMENDED)
AUTONOMOUS_STREAM_START=false
AUTONOMOUS_STREAM_STOP=false

# Recording: true = AI can start/stop recording (NOT RECOMMENDED)
AUTONOMOUS_RECORDING=false

# AI Behavior Tuning
MIN_CAMERA_HOLD_SECONDS=8
MIN_AI_ACTION_CONFIDENCE=0.85
MAX_CONSECUTIVE_SWITCHES=3
CAMERA_SWITCH_COOLDOWN_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features
ENABLE_MOCK_ATEM=true
# When true (default), the app probes the real ATEM bridge on connect and uses it
# automatically when reachable, falling back to the mock bridge otherwise.
# Set to false to force the ENABLE_MOCK_ATEM value above with no probing.
ATEM_AUTO_DETECT=true
ATEM_PROBE_TIMEOUT_SECONDS=1.5
ENABLE_AI_DIRECTOR=true
ENABLE_VISION_DETECTION=false

# Identity recognition & persistent roster memory
# Face matching uses OpenCV's YuNet (deep-learning face detector) + SFace
# (trained face-recognition embedding network) whenever their ONNX weights
# are present under backend/app/identity/models_data/ (bundled by default in
# this repo) -- both are real pretrained models from the official OpenCV
# Zoo, not a placeholder. If those weight files are ever removed/unavailable,
# face recognition automatically falls back to a classical Haar-cascade +
# LBP-histogram method (lower accuracy, but never a hard failure). Voice
# matching uses framed FFT spectral features + pitch statistics. Both are
# matched against people enrolled via POST /api/identity/roster and stored
# in Postgres (identity_* tables).
FACE_RECOGNITION_ENABLED=true
VOICE_DIARIZATION_ENABLED=true
# 0.363 is OpenCV's published operating point for the SFace model above; if
# running in classical Haar+LBP fallback mode, raise this to ~0.6-0.75.
FACE_MATCH_THRESHOLD=0.363
VOICE_MATCH_THRESHOLD=0.70
UNKNOWN_SPEAKER_TTL_SECONDS=300.0
VOICE_SILENCE_RMS=0.02

# Liveness / anti-spoofing gate on live-feed face recognition (texture +
# temporal micro-motion heuristics). Raises the bar against a printed photo
# held up to the camera; does not detect a video replay. Failed checks are
# still logged for audit but don't count as a "sighting" or feed the
# role->preset learning below.
LIVENESS_CHECK_ENABLED=true
LIVENESS_SCORE_THRESHOLD=0.35

# Role -> preset learning confidence floor (see app.director.engine): a
# learned preset is only trusted once it has at least this many
# co-occurrence observations AND leads the runner-up preset by this many,
# otherwise the cue sheet's configured fallback preset is used.
MIN_ROLE_PRESET_SAMPLES=8
MIN_ROLE_PRESET_MARGIN=3

# Local audio capture: the MGX16 has no raw-audio remote protocol, so genuine
# voice diarization needs a physical audio input on this machine (e.g. the
# mixer's monitor/aux out, or a room mic) wired into a line-in/USB interface.
# Requires the `sounddevice` package (PortAudio) and an actual input device.
ENABLE_AUDIO_CAPTURE=false
AUDIO_CAPTURE_DEVICE=
AUDIO_CAPTURE_SAMPLE_RATE=16000
AUDIO_CAPTURE_WINDOW_SECONDS=2.0
AUDIO_CAPTURE_CHANNEL_NAME=room_mic

# PTZ Camera (optional)
# Configure a single PTZOptics camera for automatic registration on startup.
# Example: CAMERA_1_HOST=192.168.1.200
CAMERA_1_NAME=PTZOptics Camera 1
CAMERA_1_HOST=
CAMERA_1_PORT=80
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=smgadmin
# VISCA-over-IP TCP port (primary control path)
CAMERA_1_VISCA_PORT=1240
# Use UDP (Sony-header) VISCA instead of TCP
CAMERA_1_VISCA_UDP=false

# Service Director (scripted Sunday service)
# ATEM program input mapping: camera 1 = PTZOptics, camera 2 = EasyWorship laptop
ATEM_CAMERA1_INPUT=1
ATEM_CAMERA2_INPUT=2
PTZ_CAMERA_ID=1
SERVICE_COUNTDOWN_SECONDS=300
SERVICE_AUTONOMOUS=true
# Scheduled auto-start (wall clock, local time); days are comma-separated mon..sun
SERVICE_AUTO_START_ENABLED=false
SERVICE_START_TIME=10:00
SERVICE_START_DAYS=sun

# Yamaha MGX16 mixer (listen-only, via the mgx-ai-mixer meter WebSocket)
ENABLE_MOCK_MIXER=true
MIXER_WS_URL=ws://127.0.0.1:9000/ws
SONG_END_SILENCE_DB=-45.0
SONG_END_HOLD_SECONDS=3.0

# EasyWorship slide control (Windows desktop; keystroke injection)
ENABLE_MOCK_EASYWORSHIP=true
EASYWORSHIP_WINDOW_TITLE=EasyWorship
EASYWORSHIP_SEND_MODE=foreground     # foreground | postmessage
# Remote agent (run backend/easyworship_agent/agent.py on the EW machine).
# When set (and mock disabled), control goes through the agent instead of
# local keystroke injection.
# EASYWORSHIP_AGENT_URL=http://192.168.30.40:8091
# Key specs per action (set these to match EasyWorship's shortcuts)
EW_KEY_NEXT_SLIDE=pagedown
EW_KEY_PREV_SLIDE=pageup
EW_KEY_NEXT_ITEM=ctrl+pagedown
EW_KEY_PREV_ITEM=ctrl+pageup
EW_KEY_CLEAR=f5
EW_KEY_LOGO=f6
EW_KEY_BLACK=f7
EW_KEY_LIVE=f9
