# ATEM Configuration
ATEM_IP=192.168.30.20
ATEM_BRIDGE_HOST=127.0.0.1
ATEM_BRIDGE_PORT=8090

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# React Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=church_production
POSTGRES_USER=church
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Anthropic Claude
# Create a key at https://console.anthropic.com/ and keep it out of source control
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Smaller/faster model used for quick cue-advance classification
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_BASE_URL=  # optional override (e.g. a proxy/gateway)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# Voyage AI embeddings (Anthropic's recommended embeddings partner -- Anthropic
# does not offer its own embeddings API). Used for production-memory retrieval
# (search_past_services, AI Director's retrieval-augmented context). Leave
# blank to use a local fallback embedding instead (lower retrieval quality,
# no external calls/cost).
# Create a key at https://dash.voyageai.com/ and keep it out of source control
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large

# Embedding provider tier: "auto" (default) = Voyage if VOYAGE_API_KEY is set,
# else local nomic-embed-text-v1.5 (free, no API key), else hashed bag-of-words.
# Force one explicitly with "voyage" | "nomic" | "hashed".
EMBEDDING_PROVIDER=auto
NOMIC_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# NOMIC_MODEL_REVISION=  # pin a commit hash in production (trust_remote_code=True)

# Production Policy
# Camera switching: true = AI can autonomously switch, false = AI recommends only
AUTONOMOUS_CAMERA_SWITCHING=true

# Transitions: true = AI can perform CUT/AUTO, false = preview only
AUTONOMOUS_TRANSITIONS=true

# Streaming: true = AI can start/stop stream (NOT RECOMMENDED)
AUTONOMOUS_STREAM_START=false
AUTONOMOUS_STREAM_STOP=false

# Recording: true = AI can start/stop recording (NOT RECOMMENDED)
AUTONOMOUS_RECORDING=false

# AI Behavior Tuning
MIN_CAMERA_HOLD_SECONDS=8
MIN_AI_ACTION_CONFIDENCE=0.85
MAX_CONSECUTIVE_SWITCHES=3
CAMERA_SWITCH_COOLDOWN_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features
ENABLE_MOCK_ATEM=true
# When true (default), the app probes the real ATEM bridge on connect and uses it
# automatically when reachable, falling back to the mock bridge otherwise.
# Set to false to force the ENABLE_MOCK_ATEM value above with no probing.
ATEM_AUTO_DETECT=true
ATEM_PROBE_TIMEOUT_SECONDS=1.5
ENABLE_AI_DIRECTOR=true
ENABLE_VISION_DETECTION=false

# Identity recognition & persistent roster memory
# Face matching uses OpenCV's YuNet (deep-learning face detector) + SFace
# (trained face-recognition embedding network) whenever their ONNX weights
# are present under backend/app/identity/models_data/ (bundled by default in
# this repo) -- both are real pretrained models from the official OpenCV
# Zoo, not a placeholder. If those weight files are ever removed/unavailable,
# face recognition automatically falls back to a classical Haar-cascade +
# LBP-histogram method (lower accuracy, but never a hard failure). Voice
# matching uses framed FFT spectral features + pitch statistics. Both are
# matched against people enrolled via POST /api/identity/roster and stored
# in Postgres (identity_* tables).
FACE_RECOGNITION_ENABLED=true
VOICE_DIARIZATION_ENABLED=true
# 0.363 is OpenCV's published operating point for the SFace model above; if
# running in classical Haar+LBP fallback mode, raise this to ~0.6-0.75.
FACE_MATCH_THRESHOLD=0.363
VOICE_MATCH_THRESHOLD=0.70
UNKNOWN_SPEAKER_TTL_SECONDS=300.0
VOICE_SILENCE_RMS=0.02

# Liveness / anti-spoofing gate on live-feed face recognition (texture +
# temporal micro-motion heuristics). Raises the bar against a printed photo
# held up to the camera; does not detect a video replay. Failed checks are
# still logged for audit but don't count as a "sighting" or feed the
# role->preset learning below.
LIVENESS_CHECK_ENABLED=true
LIVENESS_SCORE_THRESHOLD=0.35

# Role -> preset learning confidence floor (see app.director.engine): a
# learned preset is only trusted once it has at least this many
# co-occurrence observations AND leads the runner-up preset by this many,
# otherwise the cue sheet's configured fallback preset is used.
MIN_ROLE_PRESET_SAMPLES=8
MIN_ROLE_PRESET_MARGIN=3

# Local audio capture: the MGX16 has no raw-audio remote protocol, so genuine
# voice diarization needs a physical audio input on this machine (e.g. the
# mixer's monitor/aux out, or a room mic) wired into a line-in/USB interface.
# Requires the `sounddevice` package (PortAudio) and an actual input device.
ENABLE_AUDIO_CAPTURE=false
AUDIO_CAPTURE_DEVICE=
AUDIO_CAPTURE_SAMPLE_RATE=16000
AUDIO_CAPTURE_WINDOW_SECONDS=2.0
AUDIO_CAPTURE_CHANNEL_NAME=room_mic

# PTZ Camera (optional)
# Configure a single PTZOptics camera for automatic registration on startup.
# Example: CAMERA_1_HOST=192.168.1.200
CAMERA_1_NAME=PTZOptics Camera 1
CAMERA_1_HOST=
# HTTP-CGI port (PTZOptics web UI / ptzctrl.cgi)
CAMERA_1_PORT=80
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=smgadmin
# VISCA-over-IP TCP port (primary control path)
CAMERA_1_VISCA_PORT=1240
# Use UDP (Sony-header) VISCA instead of TCP
CAMERA_1_VISCA_UDP=false

# Service Director (scripted Sunday service)
# ATEM program input mapping: camera 1 = PTZOptics, camera 2 = EasyWorship laptop
ATEM_CAMERA1_INPUT=1
ATEM_CAMERA2_INPUT=2
PTZ_CAMERA_ID=1
SERVICE_COUNTDOWN_SECONDS=300
SERVICE_AUTONOMOUS=true
# Scheduled auto-start (wall clock, local time); days are comma-separated mon..sun
SERVICE_AUTO_START_ENABLED=false
SERVICE_START_TIME=10:00
SERVICE_START_DAYS=sun

# AI Service Director (reasoning layer above the cue engine; docs/ai-director.md)
# manual      = observe/log only
# assisted    = propose actions, operator approves each one (default)
# ai_directed = execute automatically (still gated by the policy flags above)
# Fully autonomous operation = AI_DIRECTOR_MODE=ai_directed + SERVICE_AUTONOMOUS=true
# + SERVICE_AUTO_START_ENABLED=true + AUTONOMOUS_CAMERA_SWITCHING/TRANSITIONS=true
# + real (non-mock) ATEM, mixer, and EasyWorship connections.
AI_DIRECTOR_MODE=assisted
AI_DIRECTOR_POLL_SECONDS=4.0
AI_DIRECTOR_MIN_CONFIDENCE=0.80
CONFIDENCE_CAMERA_CHANGE=0.85
CONFIDENCE_SLIDE_CHANGE=0.85
CONFIDENCE_ATEM_TRANSITION=0.90

# Yamaha MGX16 mixer (listen-only, via the mgx-ai-mixer meter WebSocket)
# App: https://github.com/bw00786/ai-yamaha-mixer-control (mgx-ai-mixer),
# runs on the SAME machine as this backend (USB-C MAIN into that machine).
# Its own default is --port 8000, which collides with API_PORT above, so
# start it with: uvicorn app.main:app --port 9000
ENABLE_MOCK_MIXER=true
MIXER_WS_URL=ws://127.0.0.1:9000/ws
# REST base of mgx-ai-mixer for software-DSP control (HPF/EQ/comp/trim, feedback
# guard, mix keeper). Defaults to the http:// form of MIXER_WS_URL.
# MIXER_API_URL=http://127.0.0.1:9000
SONG_END_SILENCE_DB=-45.0
SONG_END_HOLD_SECONDS=3.0

# MGX16 USB MAIN multichannel PCM capture (WO-MGX-USB-1).
# Real per-channel waveform from the console's USB-C MAIN port -> Silero VAD +
# per-role Whisper. The meter feed above stays as the degraded fallback.
# Requires the `sounddevice` package (PortAudio). Leave disabled to keep the
# pre-WO meter-only behavior exactly.
MGX_USB_ENABLED=false
MGX_USB_DEVICE_NAME=MGX
MGX_USB_DEVICE_INDEX=            # optional explicit PortAudio index override
MGX_USB_SAMPLE_RATE=48000       # negotiated with the driver; do not require 96k
MGX_USB_STALL_SECONDS=2.0       # no frames within this => channel degrades

# Voice-activity detection: auto = Silero when USB capture is active, energy
# otherwise. silero/energy force one. Silero falls back to energy loudly.
VAD_PROVIDER=auto               # auto | silero | energy
VAD_SILERO_THRESHOLD=0.5

# Which role channels get per-channel Whisper ASR (comma-separated). The
# congregation channel is VAD-only by default.
WHISPER_ROLES=pastor,liturgist,vocalist

# Vision observation & PTZ framing verification (WO-VISION-1).
# Gated by VISION_ENABLED; when false the system is byte-identical to pre-WO.
VISION_ENABLED=false
VISION_DETECTOR=auto                 # auto | yolo | opencv_hog
VISION_SNAPSHOT_HZ=1.0               # PTZOptics snapshot.jpg poll rate
VISION_RING_MINUTES=10               # in-memory diagnostic frame ring (not persisted)
VISION_MIN_FPS=0.2
VISION_STALL_SECONDS=3.0
VISION_PROGRAM_DEVICE=               # cv2 device index/name for ATEM program capture
VISION_FRAME_SOURCE=live             # live | dir (dir = replay from image folders)
VISION_FRAME_DIR=                    # FRAME_SOURCE=dir root (per-tag subdirs: program/, camera_1/)
# Per-role expected-subject ROI as fractional "x,y,w,h" (all in [0,1]).
VISION_ROLE_ROI_PASTOR=0.30,0.15,0.40,0.75
VISION_ROLE_ROI_LITURGIST=0.30,0.15,0.40,0.75
VISION_ROLE_ROI_VOCALIST=0.25,0.15,0.50,0.75
VISION_ROLE_ROI_CONGREGATION=0.05,0.20,0.90,0.70
# PTZ verification
PTZ_VERIFY_ACTION=enforce            # enforce | log (observation-only)
PTZ_VERIFY_DELAY_MS=1500
PTZ_OFFSET_MAX=0.25
PTZ_BLOCK_SECONDS=8.0
PTZ_UNVERIFIED_MAX=5
PTZ_SUBJECT_WAIT_SECONDS=30.0
# Claude-vision escalation (optional, off by default; out of the hot loop)
VISION_LLM_ENABLED=false
VISION_LLM_MAX_PX=1024
VISION_LLM_MAX_PER_MIN=2

# EasyWorship slide control
ENABLE_MOCK_EASYWORSHIP=true
# Driver: auto | remote | agent | keyboard | mock
#   remote   = EasyWorship 7.3+ native Remote Control TCP protocol (PREFERRED:
#              no window focus, absolute gotoSchedule/gotoSlide, live position
#              read-back used to confirm every command). Enable in EasyWorship:
#              Edit > Options > Advanced > "Enable Remote Control"; install
#              Bonjour; approve the pairing once via the Remote toolbar button.
#   agent    = HTTP keystroke agent on the EW machine (fallback)
#   keyboard = local keystroke injection (fallback; Live pane must have focus)
#   auto     = remote if EASYWORSHIP_REMOTE_HOST set, else agent if
#              EASYWORSHIP_AGENT_URL set, else remote via mDNS discovery
#              (pip install zeroconf), else keyboard on Windows
EASYWORSHIP_DRIVER=auto
# Remote protocol address. The port is announced over mDNS (_ezwremote._tcp) and
# can change; leave both blank to discover, or pin them once known.
EASYWORSHIP_REMOTE_HOST=
# EASYWORSHIP_REMOTE_PORT=
EASYWORSHIP_REMOTE_SERVER_NAME=          # only needed with several EW servers on the LAN
EASYWORSHIP_REMOTE_DEVICE_NAME=Church Production Director
EASYWORSHIP_REMOTE_UID=                  # pairing identity; auto-generated into
EASYWORSHIP_REMOTE_UID_FILE=.easyworship_remote_uid
EASYWORSHIP_REMOTE_DISCOVERY_SECONDS=5.0
# Confirm navigation against EasyWorship's reported pres_no/slide_no.
EASYWORSHIP_CONFIRM_ACTIONS=true
EASYWORSHIP_CONFIRM_TIMEOUT_SECONDS=1.5
# EW schedule items before the first service-plan item (e.g. 1 for a countdown).
EASYWORSHIP_SCHEDULE_OFFSET=0
# --- keystroke fallbacks only ---
EASYWORSHIP_WINDOW_TITLE=EasyWorship
EASYWORSHIP_SEND_MODE=foreground     # foreground | postmessage
# Remote keystroke agent (run backend/easyworship_agent/agent.py on the EW machine).
# EASYWORSHIP_AGENT_URL=http://192.168.30.40:8091
# Key specs per action -- EasyWorship 7.3+ defaults (Hotkeys2.ini). Comma =
# sequence: arrows only *select* a schedule item, Page Down sends it live.
EW_KEY_NEXT_SLIDE=down
EW_KEY_PREV_SLIDE=up
EW_KEY_NEXT_ITEM=right,pagedown
EW_KEY_PREV_ITEM=left,pagedown
EW_KEY_CLEAR=ctrl+c
EW_KEY_LOGO=ctrl+l
EW_KEY_BLACK=ctrl+b
EW_KEY_LIVE=pagedown

# EasyWorship slide-change verification via OCR (WO-EWVERIFY-1/-2/-3).
# Independent of VISION_ENABLED. Requires a *dedicated* camera-2/EasyWorship-
# laptop feed (e.g. an HDMI splitter + capture card on the laptop's own
# output -- NOT the switched ATEM program, which may show camera 1 instead).
# Confirms a commanded next/prev slide/item action visibly changed the
# on-screen text. Change-detection alone does NOT verify the slide is
# semantically correct for non-lyric items (sermon slides, announcements);
# lyric-aware verification is scoped separately under WO-EWVERIFY-3 below.
#
# When ENABLED, an empty DEVICE -- or a device that cannot be opened / yields
# no frames within a short startup probe -- is a hard startup failure (a
# verification feature that is "on" but never runs is a green light wired to
# nothing). On a verification failure (no visible change within the timeout,
# or a lyric mismatch) automation is halted for operator attention; the
# keystroke is never auto-retried.
SLIDE_VERIFY_ENABLED=false
SLIDE_VERIFY_DEVICE=                      # cv2 device index/name for the camera-2/slides tap
SLIDE_VERIFY_POLL_MS=400                  # stabilization poll interval (ms)
SLIDE_VERIFY_TIMEOUT_SECONDS=4.0          # give up -> alert + halt automation

# Lyric-aware semantic verification (WO-EWVERIFY-3). Independent toggle on top
# of SLIDE_VERIFY_ENABLED; enabling it without change-detection is a startup
# error. Fuzzy-matches the stable post-action OCR text against the expected
# lyric text for the current song position; below the threshold -> alert + halt.
SLIDE_VERIFY_SEMANTIC_ENABLED=false
SLIDE_VERIFY_SEMANTIC_THRESHOLD=0.75     # OCR of a captured frame is noisy; tune before tightening
